# Copy to .env for local development. On Render these are set in the dashboard / render.yaml.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset to use SQLite locally. Example PostgreSQL URL:
# DATABASE_URL=postgres://glambyyou:password@localhost:5432/glambyyou
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
TAX_RATE=0.08
