# =============================================================================
# GlowByYou API — copy this file to .env for local development
# On Render these values are set in the dashboard / render.yaml.
# =============================================================================

# --- Django core -------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# Priority: DATABASE_URL → POSTGRES_* (when POSTGRES_HOST is set) → local SQLite.
# DATABASE_URL=postgres://glambyyou:password@localhost:5432/glambyyou

# PostgreSQL (Neon)
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_SSLMODE=require

# --- Frontend & CORS ---------------------------------------------------------
# Storefront URL (Flutterwave redirects shoppers back here after payment).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Authentication (JWT) ----------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Store -------------------------------------------------------------------
TAX_RATE=0.08
PAYMENT_CURRENCY=USD

# --- Payments: Flutterwave ---------------------------------------------------
# https://app.flutterwave.com → Settings → API Keys (use test keys locally).
# Leave the secret key empty to keep online payments in simulated test mode.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Any random string; set the same value as the "Secret hash" under Settings → Webhooks.
FLUTTERWAVE_SECRET_HASH=

# --- Media: Cloudinary -------------------------------------------------------
# https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=glambyyou

# --- Email: Gmail SMTP -------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
